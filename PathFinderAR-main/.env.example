# PathFinder – Smart Campus Navigation and Guidance System
# Environment Variables Configuration Template
# Copy this file to .env for local development or add these keys to Vercel Project Settings -> Environment Variables.

# Node Environment (set to 'production' on Vercel automatically)
NODE_ENV=production

# Application Secret Key for JWT session signing (Required for secure sessions)
# Generate a random 32+ character string for production
JWT_SECRET=your-random-production-jwt-secret-here

# Database Configuration (Optional)
# If omitted or unavailable, PathFinder gracefully operates on its verified in-memory campus graph and repository dataset
# DATABASE_URL=mysql://username:password@your-database-host:3306/pathfinder_db

# Manus OAuth / Authentication (Optional - needed only for external SSO authentication)
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=https://portal.example.com
# OAUTH_SERVER_URL=https://api.example.com
# OWNER_OPEN_ID=

# AI & Voice Services (Optional - for advanced cloud voice transcription / LLM assistance)
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Map Services (Optional - campus interactive navigation uses built-in OpenStreetMap / Leaflet tiles)
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=
